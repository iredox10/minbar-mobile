# Appwrite configuration (public client-side values)
# Copy to .env or rely on Expo's .env loading. Prefix with EXPO_PUBLIC_ so they
# are inlined into the client bundle.

# Your Appwrite API endpoint
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (found in Project Settings)
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Database ID for content collections
EXPO_PUBLIC_APPWRITE_DATABASE_ID=muslim-central

# Storage Bucket IDs
EXPO_PUBLIC_APPWRITE_IMAGES_BUCKET=images
EXPO_PUBLIC_APPWRITE_AUDIO_BUCKET=audio

# YouTube Import Function ID (from Appwrite Functions)
EXPO_PUBLIC_YOUTUBE_FUNCTION_ID=youtube-import